generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id        Int         @id @default(autoincrement())
  status    OrderStatus @default(NEW)
  createdAt DateTime    @default(now())
}
